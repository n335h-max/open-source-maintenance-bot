{
  "name": "open-source-maintenance-bot",
  "version": "0.1.0",
  "private": false,
  "description": "Self-hostable GitHub maintenance bot for Claude Code and Codex.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "cli": "tsx src/cli.ts",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.0",
    "adm-zip": "^0.6.1",
    "commander": "^12.1.0",
    "fastify": "^5.2.1",
    "minimatch": "^10.0.1",
    "pg": "^8.13.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
